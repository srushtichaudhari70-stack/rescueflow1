+      const riderId = `R-${Date.now().toString(36).toUpperCase().slice(-5)}`;
+      const profile = { id: riderId, name: form.name, vehicle: form.vehicle, capacity: form.capacity, travelMins: form.travelMins, reliability: 85 };
+      const res = run((s, now) => addRider(s, now, profile));
+      if (!res.ok) return setErrors([res.reason]);
