--- /dev/null
+++ b/src/services/authService.js
@@ -0,0 +1,190 @@
+// =====================================================================
+// Prototype sign-in for RescueFlow.
+// Accounts are stored in this browser's LocalStorage, separate from the
+// operations data, so "Restore demo" never deletes anyone's account.
+// Passwords are stored as SHA-256 hashes, never as plain text.
+// NOTE: this is a hackathon prototype. Real deployments need a server-side
+// login (e.g. OAuth or a hosted auth provider).
+// =====================================================================
+
+const USERS_KEY = 'rescueflow-users';
+const SESSION_KEY = 'rescueflow-session';
+
+const ALL_PAGES = ['overview', 'donations', 'riders', 'shelters', 'dispatch', 'simulator', 'logs'];
+
+export const ROLES = {
+  admin: {
+    label: 'Operations admin',
+    short: 'Admin',
+    description: 'Runs dispatch, manages everything, triggers simulations',
+    pages: ALL_PAGES,
+  },
+  donor: {
+    label: 'Donor',
+    short: 'Donor',
+    description: 'Lists surplus food and supplies, tracks where it went',
+    pages: ['overview', 'donations'],
+  },
+  rider: {
+    label: 'Volunteer rider',
+    short: 'Rider',
+    description: 'Accepts deliveries, confirms pickup and drop-off',
+    pages: ['overview', 'mydeliveries'],
+  },
+  shelter: {
+    label: 'Shelter coordinator',
+    short: 'Shelter',
+    description: 'Updates shelter demand, resources and status',
+    pages: ['overview', 'shelters', 'logs'],
+  },
+};
+
+// Demo accounts so judges can try every role in one click.
+export const DEMO_ACCOUNTS = [
+  { id: 'U-admin', role: 'admin', name: 'Ops Admin', email: 'admin@rescueflow.org', password: 'admin123', passwordHash: '19caf3b707e521e31b957151b16bfa8999d6fd4a69d0f631c0f8666d910459fc' },
+  { id: 'U-donor', role: 'donor', name: 'Anita Rao', email: 'donor@sunrise.org', password: 'donor123', donorName: 'Sunrise Banquet Hall', passwordHash: '9b3eefb2c61af6a0e8a221f94751dcbcf5ca4dfac1ba84baaaf9795711a4cc13' },
+  { id: 'U-rider', role: 'rider', name: 'Priya Sharma', email: 'rider@rescueflow.org', password: 'rider123', riderId: 'R-101', passwordHash: '644fc788a94953963941d0b505fd2ebb182c8d87475f53087d2d3e73d94d5543' },
+  { id: 'U-shelter', role: 'shelter', name: 'Joseph Mathew', email: 'shelter@riverside.org', password: 'shelter123', shelterId: 'SH-A', passwordHash: '89692ecf00341dca2382ba1155dcd8a2a9b64c5d6f1122e631dce4d2d989bdd2' },
+];
+
+// ---------- SHA-256 (small pure-JS version, works on http and https) ----------
+export function sha256(text) {
+  const K = [];
+  const H = [];
+  let n = 2;
+  let found = 0;
+  const frac = (x) => ((x - Math.floor(x)) * 0x100000000) | 0;
+  while (found < 64) {
+    let prime = true;
+    for (let f = 2; f * f <= n; f += 1) if (n % f === 0) { prime = false; break; }
+    if (prime) {
+      if (found < 8) H[found] = frac(Math.pow(n, 1 / 2));
+      K[found] = frac(Math.pow(n, 1 / 3));
+      found += 1;
+    }
+    n += 1;
+  }
+  const bytes = new TextEncoder().encode(text);
+  const bitLen = bytes.length * 8;
+  const padded = new Uint8Array(((bytes.length + 9 + 63) >> 6) << 6);
+  padded.set(bytes);
+  padded[bytes.length] = 0x80;
+  const view = new DataView(padded.buffer);
+  view.setUint32(padded.length - 4, bitLen >>> 0);
+  view.setUint32(padded.length - 8, Math.floor(bitLen / 0x100000000));
+  const w = new Int32Array(64);
+  const rotr = (x, r) => (x >>> r) | (x << (32 - r));
+  for (let i = 0; i < padded.length; i += 64) {
+    for (let t = 0; t < 16; t += 1) w[t] = view.getInt32(i + t * 4);
+    for (let t = 16; t < 64; t += 1) {
+      const s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >>> 3);
+      const s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >>> 10);
+      w[t] = (w[t - 16] + s0 + w[t - 7] + s1) | 0;
+    }
+    let [a, b, c, d, e, f, g, h] = H;
+    for (let t = 0; t < 64; t += 1) {
+      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
+      const ch = (e & f) ^ (~e & g);
+      const t1 = (h + S1 + ch + K[t] + w[t]) | 0;
+      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
+      const maj = (a & b) ^ (a & c) ^ (b & c);
+      const t2 = (S0 + maj) | 0;
+      h = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;
+    }
+    H[0] = (H[0] + a) | 0; H[1] = (H[1] + b) | 0; H[2] = (H[2] + c) | 0; H[3] = (H[3] + d) | 0;
+    H[4] = (H[4] + e) | 0; H[5] = (H[5] + f) | 0; H[6] = (H[6] + g) | 0; H[7] = (H[7] + h) | 0;
+  }
+  return H.map((x) => (x >>> 0).toString(16).padStart(8, '0')).join('');
+}
+
+const normalizeEmail = (e) => String(e || '').trim().toLowerCase();
+export const hashPassword = (email, password) => sha256(`${normalizeEmail(email)}:${password}`);
+
+// ---------- Storage ----------
+function read(key) {
+  try {
+    const raw = localStorage.getItem(key);
+    return raw ? JSON.parse(raw) : null;
+  } catch {
+    return null;
+  }
+}
+function write(key, value) {
+  try {
+    if (value === null) localStorage.removeItem(key);
+    else localStorage.setItem(key, JSON.stringify(value));
+  } catch {
+    /* storage blocked: sign-in still works for this tab */
+  }
+}
+
+let memoryUsers = null;
+export function loadUsers() {
+  const stored = read(USERS_KEY) ?? memoryUsers ?? [];
+  // Demo accounts always exist (and can't be overwritten)
+  const custom = stored.filter((u) => !DEMO_ACCOUNTS.some((d) => d.id === u.id));
+  return [...DEMO_ACCOUNTS.map(({ password, ...u }) => u), ...custom];
+}
+function saveCustomUsers(users) {
+  const custom = users.filter((u) => !DEMO_ACCOUNTS.some((d) => d.id === u.id));
+  memoryUsers = custom;
+  write(USERS_KEY, custom);
+}
+
+export function loadSession() {
+  const s = read(SESSION_KEY);
+  if (!s) return null;
+  return loadUsers().find((u) => u.id === s.userId) ?? null;
+}
+export function saveSession(user) {
+  write(SESSION_KEY, user ? { userId: user.id, at: Date.now() } : null);
+}
+
+// ---------- Sign in / sign up ----------
+export function login(email, password) {
+  const e = normalizeEmail(email);
+  if (!e || !password) return { ok: false, reason: 'Enter your email and password' };
+  const user = loadUsers().find((u) => u.email === e);
+  if (!user || user.passwordHash !== hashPassword(e, password)) {
+    return { ok: false, reason: 'Email or password is incorrect' };
+  }
+  return { ok: true, user };
+}
+
+export function validateSignup(form) {
+  const errors = [];
+  const email = normalizeEmail(form.email);
+  if (!form.name?.trim()) errors.push('Enter your full name');
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.push('Enter a valid email address');
+  else if (loadUsers().some((u) => u.email === email)) errors.push('An account with this email already exists — sign in instead');
+  if (!form.password || form.password.length < 6) errors.push('Password must be at least 6 characters');
+  if (form.password !== form.confirm) errors.push('Passwords do not match');
+  if (!ROLES[form.role] || form.role === 'admin') errors.push('Choose donor, volunteer rider or shelter coordinator');
+  if (form.role === 'donor' && !form.donorName?.trim()) errors.push('Enter your organisation name');
+  if (form.role === 'shelter' && !form.shelterId) errors.push('Choose the shelter you coordinate');
+  if (form.role === 'rider') {
+    const cap = Number(form.capacity);
+    if (!Number.isInteger(cap) || cap <= 0 || cap > 500) errors.push('Carrying capacity must be a whole number between 1 and 500');
+  }
+  return errors;
+}
+
+// riderId must already be created in app data for rider accounts
+export function createAccount(form, extra = {}) {
+  const email = normalizeEmail(form.email);
+  const user = {
+    id: `U-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`,
+    role: form.role,
+    name: form.name.trim(),
+    email,
+    passwordHash: hashPassword(email, form.password),
+    createdAt: Date.now(),
+    ...extra,
+  };
+  saveCustomUsers([...loadUsers(), user]);
+  return user;
+}
+
+export function canAccess(user, page) {
+  return !!user && ROLES[user.role]?.pages.includes(page);
+}
