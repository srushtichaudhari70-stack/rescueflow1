+
+export default function Login() {
+  const { state, run, toast, navigate } = useApp();
+  const { signIn } = useAuth();
+  const [mode, setMode] = useState('signin');
+
+  const meals = state.batches.filter((b) => !b.cancelled && b.expiresAt > Date.now()).reduce((n, b) => n + b.qty.available, 0);
+  const riders = state.riders.filter((r) => !['Off Duty', 'Unresponsive'].includes(r.status)).length;
+  const shelters = state.shelters.filter((s) => s.status === 'Open').length;
+  const rescued = state.batches.reduce((n, b) => n + b.qty.delivered, 0);
+
+  const done = (user, isNew = false) => {
+    run((s, now) => addLog(s, now, {
+      type: isNew ? 'Account created' : 'User signed in',
+      description: `${user.name} (${ROLES[user.role].label}) ${isNew ? 'joined RescueFlow' : 'signed in'}`,
+      riderId: user.riderId ?? null,
+      status: 'info',
+    }));
+    signIn(user);
+    navigate('overview');
+    toast('success', isNew ? 'Welcome to RescueFlow' : `Welcome back, ${user.name.split(' ')[0]}`, `Signed in as ${ROLES[user.role].label}`);
