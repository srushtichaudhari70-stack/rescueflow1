+import { Bike, UserPlus } from 'lucide-react';
+import { useApp } from '../context/AppContext.jsx';
+import { useAuth } from '../context/AuthContext.jsx';
+import AssignmentTable from '../components/AssignmentTable.jsx';
+import RiderCard from '../components/RiderCard.jsx';
+import { Empty, StatusBadge } from '../components/ui.jsx';
+import { ACTIVE_STATUSES, shelterLabel } from '../services/dispatchEngine.js';
+import { addRider } from '../services/reservationService.js';
+
+export default function MyDeliveries() {
+  const { state, now, run, toast } = useApp();
+  const { user } = useAuth();
+  const rider = state.riders.find((r) => r.id === user.riderId);
+
+  if (!rider) {
+    const recreate = () => {
+      const res = run((s, t) => addRider(s, t, { ...(user.riderProfile ?? { name: user.name, capacity: 30, travelMins: 10 }), id: user.riderId, name: user.name }));
+      if (res.ok) toast('success', 'Rider profile restored', 'You can receive deliveries again');
+      else toast('error', 'Could not restore profile', res.reason);
+    };
+    return (
+      <div className="page">
+        <div className="card">
+          <Empty icon={<Bike size={24} />}>
+            <p style={{ marginBottom: 12 }}>Your rider profile isn't in the current data (the demo was probably restored).</p>
+            <button className="btn btn-primary" onClick={recreate}><UserPlus size={15} /> Restore my rider profile</button>
+          </Empty>
+        </div>
+      </div>
+    );
+  }
+
+  const mine = state.assignments.filter((a) => a.riderId === rider.id);
+  const active = mine.filter((a) => ACTIVE_STATUSES.includes(a.status));
+  const past = mine.filter((a) => !ACTIVE_STATUSES.includes(a.status)).slice(0, 12);
+
+  return (
+    <div className="page">
+      <div className="page-head">
+        <div>
+          <h1>My deliveries</h1>
+          <p>New jobs appear here when the dispatch team assigns you. Acknowledge within {state.settings.ackTimeoutSecs} seconds, or the job is passed to another rider.</p>
+        </div>
+      </div>
+      <div className="grid" style={{ gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 2fr)', alignItems: 'start' }} id="rider-grid">
+        <RiderCard rider={rider} />
+        <div className="stack">
+          <div className="card">
+            <div className="card-head"><h3>Current jobs</h3><span className="sub">{active.length} active</span></div>
+            <AssignmentTable assignments={active} now={now} emptyText="No jobs right now. Stay available and new deliveries will show up here." />
+          </div>
+          <div className="card">
+            <div className="card-head"><h3>Past jobs</h3></div>
+            {past.length === 0 ? <Empty>No completed jobs yet</Empty> : (
+              <div className="table-wrap">
+                <table className="table">
+                  <thead><tr><th>Job</th><th>Shelter</th><th>Cargo</th><th>Outcome</th></tr></thead>
+                  <tbody>
+                    {past.map((a) => (
+                      <tr key={a.id}>
+                        <td><b>{a.id}</b><div className="cell-sub mono">{a.batchId}</div></td>
+                        <td>{shelterLabel(state.shelters.find((s) => s.id === a.shelterId))}</td>
+                        <td className="mono">{a.qty} {a.unit}</td>
+                        <td><StatusBadge status={a.status} /></td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+            )}
+          </div>
+        </div>
+      </div>
+      <style>{`@media (max-width: 1080px) { #rider-grid { grid-template-columns: minmax(0,1fr) !important; } }`}</style>
+    </div>
+  );
+}
