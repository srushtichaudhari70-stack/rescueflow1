+
+        {form.role === 'donor' && (
+          <div className="field full">
+            <label htmlFor="su-org">Organisation</label>
+            <input id="su-org" className="input" list="su-donors" value={form.donorName} onChange={set('donorName')} placeholder="e.g. GreenLeaf Restaurant" />
+            <datalist id="su-donors">{DONORS.map((d) => <option key={d} value={d} />)}</datalist>
+            <span className="hint">You'll see the donations listed under this name</span>
