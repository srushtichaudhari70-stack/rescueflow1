+
+      <div className="login-divider"><span>Demo accounts for judges</span></div>
+      <div className="demo-grid">
+        {DEMO_ACCOUNTS.map((acc) => {
+          const Icon = ROLE_ICONS[acc.role];
+          return (
+            <button key={acc.id} type="button" className="demo-btn" onClick={() => quick(acc)}>
+              <span className="demo-icon"><Icon size={16} /></span>
+              <span style={{ minWidth: 0 }}>
+                <span className="demo-role">{ROLES[acc.role].label}</span>
+                <span className="demo-cred mono">{acc.email}</span>
+                <span className="demo-cred mono">password: {acc.password}</span>
+              </span>
+            </button>
+          );
+        })}
+      </div>
+    </>
+  );
+}
+
+function SignUpForm({ onDone }) {
+  const { state, run } = useApp();
+  const [form, setForm] = useState({
+    role: 'donor', name: '', email: '', password: '', confirm: '',
+    donorName: '', shelterId: '', vehicle: 'Scooter', capacity: '30', travelMins: '10',
+  });
+  const [errors, setErrors] = useState([]);
+  const set = (k) => (e) => setForm((f) => ({ ...f, [k]: e.target.value }));
+
+  const submit = (e) => {
+    e.preventDefault();
