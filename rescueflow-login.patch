+            <div className="logo-sub" style={{ color: '#9fb0c8' }}>Perishable aid coordination</div>
+          </div>
+        </div>
+        <div className="login-pitch">
+          <h1>Get surplus food to people before it spoils.</h1>
+          <p>Donors, volunteer riders and shelters work from one live board. Every delivery is checked against shelf-life, rider capacity, shelter demand and what the shelter can actually use.</p>
+        </div>
+        <div className="login-stats">
+          <div><b className="mono">{meals}</b><span>units ready to move</span></div>
+          <div><b className="mono">{riders}</b><span>riders on duty</span></div>
+          <div><b className="mono">{shelters}</b><span>shelters open</span></div>
+          <div><b className="mono">{rescued}</b><span>units delivered</span></div>
+        </div>
+        <ul className="login-roles">
+          {Object.entries(ROLES).map(([key, r]) => {
+            const Icon = ROLE_ICONS[key];
+            return (
+              <li key={key}><Icon size={15} /><span><b>{r.label}</b> · {r.description}</span></li>
+            );
+          })}
+        </ul>
+      </section>
+
+      <section className="login-panel">
+        <div className="login-card">
+          <h2>{mode === 'signin' ? 'Sign in' : 'Create your account'}</h2>
+          <p className="muted" style={{ marginTop: 4, marginBottom: 18 }}>
+            {mode === 'signin' ? 'Everyone signs in. What you see depends on your role.' : 'Join as a donor, volunteer rider or shelter coordinator.'}
+          </p>
+          <div className="tabs" style={{ width: '100%', marginBottom: 18 }}>
+            <button type="button" className={`tab ${mode === 'signin' ? 'active' : ''}`} style={{ flex: 1 }} onClick={() => setMode('signin')}>Sign in</button>
+            <button type="button" className={`tab ${mode === 'signup' ? 'active' : ''}`} style={{ flex: 1 }} onClick={() => setMode('signup')}>Create account</button>
+          </div>
+          {mode === 'signin' ? <SignInForm onDone={done} /> : <SignUpForm onDone={done} />}
+        </div>
+        <p className="subtle" style={{ fontSize: 12, textAlign: 'center', marginTop: 16, maxWidth: 440 }}>
+          Prototype sign-in: accounts are saved in this browser only, and passwords are stored as hashes.
+        </p>
+      </section>
+    </div>
+  );
+}
